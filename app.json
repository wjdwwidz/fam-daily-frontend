{
  "expo": {
    "name": "우리끼리",
    "slug": "fam-daily-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.famdaily"
    },
    "android": {
      "package": "com.famdaily",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF6FB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "가족과 나눌 사진을 고르기 위해 사진첩에 접근합니다."
        }
      ],
      "expo-video"
    ],
    "scheme": "famdaily",
    "extra": {
      "eas": {
        "projectId": "5764520b-e55a-40be-a26d-4d7bf63e1222"
      }
    },
    "owner": "hye14"
  }
}
